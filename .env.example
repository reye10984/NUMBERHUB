# Copy to .env for local development; never commit real credentials.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=instance/numberhub.db
# Required for real 5SIM catalogue account actions and purchases
# Customer pricing: USD provider price converted to NGN, then marked up
USD_TO_NGN_RATE=1500
FIVE_SIM_MARKUP_PERCENT=30
FIVE_SIM_API_KEY=

# Paystack wallet deposits (keep real secret keys out of source control)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
WALLET_MIN_DEPOSIT_KOBO=10000
WALLET_MAX_DEPOSIT_KOBO=50000000

# Public HTTPS base URL used to construct the Paystack callback
PUBLIC_BASE_URL=https://your-domain.example
